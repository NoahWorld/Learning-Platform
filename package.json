{
  "name": "learning-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "NODE_ENV=development PORT=3001 node --watch server/index.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "test": "node --test --test-reporter spec tests/*.test.mjs",
    "check": "npm run build && npm test",
    "import:data": "node server/import-content.mjs",
    "exams:build-short-series": "node scripts/build-short-exam-series.mjs",
    "exams:archive-long": "node server/archive-long-exams.mjs",
    "user:upsert": "node server/manage-user.mjs upsert"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.0",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.0",
    "lucide-react": "^1.31.0",
    "mime-types": "^3.0.2",
    "minio": "^8.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
