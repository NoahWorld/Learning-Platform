MINIO_ACCESS_KEY=replace-with-a-random-access-key
MINIO_SECRET_KEY=replace-with-a-random-secret-of-at-least-20-characters
MINIO_BUCKET=learning-assets
# 大陆服务器若无法访问 Docker Hub，可改为可信的镜像代理地址。
NODE_IMAGE=node:22-bookworm-slim
# 编译原生模块时若 Debian 官方源不稳定，可配置当地镜像；留空时使用官方源。
DEBIAN_MIRROR=
DEBIAN_SECURITY_MIRROR=
